  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anthonyzok521/mcp-magicavoxel.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
